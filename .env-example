# Copy this file to .env for local and device-specific validation.
# Keep .env out of git; it may contain private hosts, paths, or API keys.

# OpenWrt target used by end-to-end validation. This can be an SSH alias
# from ~/.ssh/config, such as "one", or a full target such as "root@192.0.2.1".
EDGEPULSE_OPENWRT_SSH_TARGET=one

# Optional SSH settings for scripts that choose to build a full ssh command.
EDGEPULSE_OPENWRT_SSH_PORT=22
EDGEPULSE_OPENWRT_SSH_OPTS=

# Package artifacts to deploy during OpenWrt end-to-end validation.
EDGEPULSE_OPENWRT_EDGE_PACKAGE=/home/nier/.openclaw/workspace/openwrt-build/bin/packages/aarch64_cortex-a53/edgepulse/edgepulse-1.apk
EDGEPULSE_OPENWRT_LUCI_PACKAGE=/home/nier/.openclaw/workspace/openwrt-build/bin/packages/aarch64_cortex-a53/edgepulse/luci-app-edgepulse-1.apk

# Runtime model configuration to apply on the OpenWrt target for model
# compatibility testing. Do not commit real API keys.
EDGEPULSE_AI_AGENT_ENABLED=1
EDGEPULSE_AI_AGENT_LOCAL_ONLY=0
EDGEPULSE_AI_MODEL_SECTION=remote_reasoner
EDGEPULSE_AI_BASE_URL=https://example.invalid/v1
EDGEPULSE_AI_MODEL=qwen/qwen3.6-35b-a3b
EDGEPULSE_AI_API_KEY=
EDGEPULSE_AI_API_KEY_ENV=EDGEPULSE_AI_API_KEY
EDGEPULSE_AI_TIMEOUT_SEC=60
EDGEPULSE_AI_RETRY_COUNT=0
EDGEPULSE_AI_MAX_TOKENS=2048
EDGEPULSE_AI_NO_THINK=0

# Local integration test knobs.
EDGEPULSE_AGENT_TEST_PORT=18181

# Optional end-to-end test prompt overrides.
EDGEPULSE_AGENT_E2E_PROMPT="Summarize CPU, memory, uptime, and network health from the provided telemetry in one concise sentence."
EDGEPULSE_AGENT_E2E_EXPECT_FINISH_REASON=stop
EDGEPULSE_E2E_APPLY_CONFIG=0
