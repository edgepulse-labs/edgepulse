config edgepulse 'main'
	option enabled '1'
	option db_path '/tmp/edgepulse/edgepulse.db'
	option sample_interval_sec '5'
	option feature_interval_sec '60'
	option retention_raw_sec '3600'
	option retention_feature_sec '86400'
	option enable_cpu '1'
	option enable_memory '1'
	option enable_network '1'
	option enable_thermal '1'
	option enable_wireless '1'
	option enable_conntrack '1'
	option enable_nft '1'

config agent 'agent'
	option enabled '0'
	option local_only '1'
	option memory_enabled '1'
	option shell_enabled '1'
	option ubus_enabled '1'
	option policy_profile 'read_only'
	option request_timeout_sec '60'
	option heartbeat_interval_sec '60'
	option tool_timeout_sec '5'
	option max_tool_output_bytes '8192'

config model 'remote_reasoner'
	option enabled '0'
	option role 'planner,analyzer,responder'
	option base_url ''
	option model ''
	option api_key ''
	option api_key_env 'EDGEPULSE_AI_API_KEY'
	option timeout_sec '30'
	option retry_count '1'
