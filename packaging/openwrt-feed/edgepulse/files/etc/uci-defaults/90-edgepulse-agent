#!/bin/sh

set -eu

ensure_agent_section()
{
	uci -q get edgepulse.main >/dev/null || {
		uci set edgepulse.main='edgepulse'
		uci set edgepulse.main.enabled='1'
		uci set edgepulse.main.db_path='/tmp/edgepulse/edgepulse.db'
		uci set edgepulse.main.sample_interval_sec='5'
		uci set edgepulse.main.feature_interval_sec='60'
		uci set edgepulse.main.retention_raw_sec='3600'
		uci set edgepulse.main.retention_feature_sec='86400'
	}

	uci -q get edgepulse.agent >/dev/null || {
		uci set edgepulse.agent='agent'
	}

	uci -q get edgepulse.agent.enabled >/dev/null || uci set edgepulse.agent.enabled='0'
	uci -q get edgepulse.agent.local_only >/dev/null || uci set edgepulse.agent.local_only='1'
	uci -q get edgepulse.agent.memory_enabled >/dev/null || uci set edgepulse.agent.memory_enabled='1'
	uci -q get edgepulse.agent.shell_enabled >/dev/null || uci set edgepulse.agent.shell_enabled='1'
	uci -q get edgepulse.agent.ubus_enabled >/dev/null || uci set edgepulse.agent.ubus_enabled='1'
	uci -q get edgepulse.agent.policy_profile >/dev/null || uci set edgepulse.agent.policy_profile='read_only'
	uci -q get edgepulse.agent.request_timeout_sec >/dev/null || uci set edgepulse.agent.request_timeout_sec='60'
	uci -q get edgepulse.agent.heartbeat_interval_sec >/dev/null || uci set edgepulse.agent.heartbeat_interval_sec='60'
	uci -q get edgepulse.agent.tool_timeout_sec >/dev/null || uci set edgepulse.agent.tool_timeout_sec='5'
	uci -q get edgepulse.agent.max_tool_output_bytes >/dev/null || uci set edgepulse.agent.max_tool_output_bytes='8192'
}

ensure_model_section()
{
	uci -q get edgepulse.remote_reasoner >/dev/null || {
		uci set edgepulse.remote_reasoner='model'
	}

	uci -q get edgepulse.remote_reasoner.enabled >/dev/null || uci set edgepulse.remote_reasoner.enabled='0'
	uci -q get edgepulse.remote_reasoner.role >/dev/null || uci set edgepulse.remote_reasoner.role='planner,analyzer,responder'
	uci -q get edgepulse.remote_reasoner.base_url >/dev/null || uci set edgepulse.remote_reasoner.base_url=''
	uci -q get edgepulse.remote_reasoner.model >/dev/null || uci set edgepulse.remote_reasoner.model=''
	uci -q get edgepulse.remote_reasoner.api_key_env >/dev/null || uci set edgepulse.remote_reasoner.api_key_env='EDGEPULSE_AI_API_KEY'
	uci -q get edgepulse.remote_reasoner.timeout_sec >/dev/null || uci set edgepulse.remote_reasoner.timeout_sec='30'
	uci -q get edgepulse.remote_reasoner.retry_count >/dev/null || uci set edgepulse.remote_reasoner.retry_count='1'
}

ensure_agent_section
ensure_model_section
uci commit edgepulse

exit 0
