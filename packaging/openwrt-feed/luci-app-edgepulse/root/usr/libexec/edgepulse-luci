#!/bin/sh

set -eu

cmd="${1:-}"
shift || true

case "$cmd" in
	status)
		exec /usr/bin/edgepulse-ctl status --json
		;;
	latest)
		exec /usr/bin/edgepulse-ctl latest --json
		;;
	features)
		window="${1:-60}"
		case "$window" in
			60|300|900|60s|5m|15m)
				exec /usr/bin/edgepulse-ctl features --json --window "$window"
				;;
			*)
				echo '{"error":"invalid feature window","features":[]}'
				exit 2
				;;
		esac
		;;
	*)
		echo '{"error":"unsupported EdgePulse LuCI command"}'
		exit 2
		;;
esac
