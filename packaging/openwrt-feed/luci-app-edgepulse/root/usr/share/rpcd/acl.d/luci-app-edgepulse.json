{
	"luci-app-edgepulse": {
		"description": "Grant read access to EdgePulse telemetry status",
		"read": {
			"file": {
				"/usr/libexec/edgepulse-luci": [ "exec" ],
				"/tmp/edgepulse/edgepulse.json": [ "read" ]
			},
			"uci": [ "edgepulse" ]
		},
		"write": {
			"uci": [ "edgepulse" ]
		}
	}
}
